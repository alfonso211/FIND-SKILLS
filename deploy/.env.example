# Copiar a .env y rellenar. NO subir .env al repositorio.
# Generar claves con:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Dominio público del PMS (debe apuntar con un registro A a la IP del servidor)
PMS_DOMINIO=pms.inversiete.es

# Contraseña de la base de datos (solo la usa la aplicación)
DB_PASSWORD=

# Clave de firma de sesiones. Si se cambia, todos los usuarios deben volver a entrar.
PMS_SECRET_KEY=

# Clave de cifrado de las copias de documentos de identidad (Fernet). Generar con:
#   openssl rand -base64 32 | tr '+/' '-_'
# ¡Guárdela fuera del servidor! Sin ella no se pueden recuperar las copias de los documentos.
PMS_DOCS_KEY=

# Superadministrador técnico (cuenta de soporte, distinta de los usuarios de dirección)
PMS_ADMIN_EMAIL=admin@inversiete.es
PMS_ADMIN_PASSWORD=

# Duración de la sesión en horas
PMS_TOKEN_HOURS=12

# Avisos por correo (OT urgentes y resumen diario). Vacío = no se envían correos.
# Use un buzón propio para el PMS, p.ej. avisos@inversiete.es.
#   IONOS:          PMS_SMTP_HOST=smtp.ionos.es        PMS_SMTP_PORT=587  PMS_SMTP_SEGURIDAD=starttls
#   Microsoft 365:  PMS_SMTP_HOST=smtp.office365.com   PMS_SMTP_PORT=587  PMS_SMTP_SEGURIDAD=starttls
#   Arsys:          PMS_SMTP_HOST=smtp.servidor-correo.net PMS_SMTP_PORT=587 PMS_SMTP_SEGURIDAD=starttls
PMS_SMTP_HOST=
PMS_SMTP_PORT=587
PMS_SMTP_USER=
PMS_SMTP_PASSWORD=
PMS_SMTP_FROM=
PMS_SMTP_SEGURIDAD=starttls
# Hora del resumen diario (hora de Madrid)
PMS_AVISOS_HORA=07:30
# Mantenimiento diario de las 06:00 (deploy/mantenimiento.sh): correo urgente si hay un fallo grave
PMS_MANTENIMIENTO_EMAIL=alfonso@inversiete.es
